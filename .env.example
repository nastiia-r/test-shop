# Unsplash "Access Key" — https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Secret used to sign session cookies (any long random string).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional: where users and saved photos are stored.
#   file    — JSON file in ./.data (default for local development)
#   netlify — Netlify Blobs (picked automatically when running on Netlify)
#   memory  — in-process only, resets on restart
# STORAGE_DRIVER=file
